PORT=5000
NODE_ENV=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=billing_lifemedia
DB_PORT=3306

# Hanya dipakai oleh `npm run migrate:legacy-php`; sumber PHP lama tetap read-only.
LEGACY_DB_HOST=localhost
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
LEGACY_DB_PORT=3306
LEGACY_CONFIG_PATH=

# Ganti dengan secret acak panjang sebelum memakai database/production.
JWT_SECRET=ganti_dengan_secret_acak_panjang
JWT_EXPIRES_IN=7d

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

PPPOE_API_URL=http://202.169.232.239:8078/api/pppoes
PPPOE_API_TOKEN=
PPPOE_TIMEOUT=6000

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
